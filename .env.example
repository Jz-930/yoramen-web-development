# Server-only contact email settings. Never use a NEXT_PUBLIC_ prefix for these.
# Create a Sending Access key for your verified domain in Resend.
RESEND_API_KEY=
# A bare sender address on the domain/subdomain verified in Resend.
CONTACT_FROM_EMAIL=website@notifications.yoramen.ca
# Fixed recipient for the website. One recipient uses one email of provider quota.
CONTACT_TO_EMAILS=info@yoramen.ca
